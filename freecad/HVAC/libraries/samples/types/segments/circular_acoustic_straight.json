{
  "id": "circular_acoustic_straight",
  "label": "Circular Acoustic Straight",
  "category": "segment",
  "family": [
    "straight_segment"
  ],
  "profiles": [
    "Circular"
  ],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "properties": [
    {
      "name": "Diameter",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Clear-air duct diameter",
      "default": 100.0,
      "validation": {
        "exclusiveMinimum": 0.0
      }
    },
    {
      "name": "LinerThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Perforated inner liner thickness",
      "default": 1.0,
      "validation": {
        "exclusiveMinimum": 0.0
      }
    },
    {
      "name": "AbsorberThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Acoustic absorber fill thickness, between the liner and the outer jacket",
      "default": 25.0,
      "validation": {
        "exclusiveMinimum": 0.0
      }
    },
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Outer jacket sheet metal thickness",
      "default": 0.8,
      "validation": {
        "exclusiveMinimum": 0.0
      }
    }
  ],
  "construction": {
    "layers": [
      {
        "id": "liner",
        "roles": [
          "flow_surface",
          "acoustic_liner"
        ],
        "default_material_role": "acoustic_liner",
        "thickness_property": "LinerThickness"
      },
      {
        "id": "absorber",
        "roles": [
          "acoustic_absorber"
        ],
        "default_material_role": "acoustic_absorber",
        "thickness_property": "AbsorberThickness"
      },
      {
        "id": "jacket",
        "roles": [
          "outer_jacket",
          "structural_shell"
        ],
        "default_material_role": "outer_jacket",
        "thickness_property": "Thickness"
      }
    ]
  },
  "geometry": {
    "backend": "partscript",
    "file": "models/circular_acoustic_straight.py"
  }
}
