{
  "id": "branch_tee_radius_center",
  "label": "Tee - Radius (Center aligned)",
  "category": "junction",
  "topology": "branch",
  "family": ["branch.tee", "branch.tee.3d"],
  "profiles": ["Circular", "Rectangular", "Oval"],
  "selection": {
    "kind": "model",
    "priority": 45
  },
  "constraints": {
    "degree": 3
  },
  "properties": [
    {
      "name": "TrimRunA",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for run port A",
      "default": 100.0
    },
    {
      "name": "TrimRunB",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for run port B",
      "default": 100.0
    },
    {
      "name": "TrimBranch",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for the branch port",
      "default": 150.0
    },
    {
      "name": "BranchRadius",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Bend radius of the branch takeoff as it curves into the run",
      "default": 150.0
    },
    {
      "name": "ReverseBranchBend",
      "prop_type": "App::PropertyBool",
      "group": "Dimensions",
      "description": "Reverse the branch bend toward the opposite run leg",
      "default": false
    }
  ],
  "generator": {
    "module": "junctions",
    "function": "build_tee_radius_center"
  },
  "connection_lengths": {
    "module": "junctions",
    "function": "measure_tee_radius_center"
  },
  "loss": {
    "module": "junction_losses",
    "function": "loss_tee_generic"
  }
}
