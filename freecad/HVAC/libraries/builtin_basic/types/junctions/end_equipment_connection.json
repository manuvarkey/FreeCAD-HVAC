{
  "id": "end_equipment_connection",
  "label": "Equipment Connection",
  "category": "junction",
  "topology": "end",
  "family": [
    "end.terminal.equipment"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 59
  },
  "constraints": {
    "degree": 1,
    "qualifiers": {
      "terminal_function": {
        "enum": [
          "Source"
        ]
      }
    }
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "TrimNeck",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Length of the collar from the duct end to the equipment face. 0 uses a quarter of the duct size",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "FanConnection",
      "prop_type": "App::PropertyEnumeration",
      "group": "Parameters",
      "description": "How the duct leaves the unit's fan, for its system-effect loss (supply connections only). None adds nothing",
      "default": "None",
      "validation": {
        "enum": [
          "None",
          "Transition symmetric",
          "Transition asymmetric top level",
          "Transition asymmetric top 10 down",
          "Transition asymmetric top 10 up",
          "Transition pyramidal",
          "Discharge into casing"
        ]
      }
    },
    {
      "name": "FanOutletWidth",
      "prop_type": "App::PropertyLength",
      "group": "Parameters",
      "description": "Width of the fan outlet",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "FanOutletHeight",
      "prop_type": "App::PropertyLength",
      "group": "Parameters",
      "description": "Height of the fan outlet",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "TransitionAngle",
      "prop_type": "App::PropertyAngle",
      "group": "Parameters",
      "description": "Included angle of the transition from the fan outlet to the duct",
      "default": 20.0,
      "validation": {
        "minimum": 0.0,
        "maximum": 180.0
      }
    },
    {
      "name": "FanWheel",
      "prop_type": "App::PropertyEnumeration",
      "group": "Parameters",
      "description": "Fan wheel, for Discharge into casing",
      "default": "Backward inclined",
      "validation": {
        "enum": [
          "Airfoil",
          "Backward inclined",
          "Forward curved"
        ]
      }
    }
  ],
  "generator": {
    "module": "shared:terminals",
    "function": "build_terminal_plain"
  },
  "connection_lengths": {
    "module": "shared:terminals",
    "function": "measure_terminal_plain"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_equipment_connection"
  }
}
