{
  "id": "end_exit_conical",
  "label": "Exit - Conical Diffuser",
  "category": "junction",
  "topology": "end",
  "family": [
    "end.terminal.exit"
  ],
  "profiles": [
    "Circular"
  ],
  "selection": {
    "kind": "model",
    "priority": 45
  },
  "constraints": {
    "degree": 1
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "TrimNeck",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Length of the straight collar between the fitting and the duct",
      "default": 50.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "ConeAngle",
      "prop_type": "App::PropertyAngle",
      "group": "Dimensions",
      "description": "Included angle between opposite walls",
      "default": 14.0,
      "validation": {
        "minimum": 0.0,
        "maximum": 180.0
      }
    },
    {
      "name": "AreaRatio",
      "prop_type": "App::PropertyFloat",
      "group": "Dimensions",
      "description": "Area of the exit opening over the area of the duct",
      "default": 2.0,
      "validation": {
        "minimum": 1.0
      }
    },
    {
      "name": "ScreenFreeArea",
      "prop_type": "App::PropertyFloat",
      "group": "Parameters",
      "description": "Open fraction of a screen across the opening, from 0 to 1. 0 means there is no screen",
      "default": 0.0,
      "validation": {
        "minimum": 0.0,
        "maximum": 1.0
      }
    }
  ],
  "generator": {
    "module": "shared:terminals",
    "function": "build_terminal_diffusing"
  },
  "connection_lengths": {
    "module": "shared:terminals",
    "function": "measure_terminal_diffusing"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_exit_conical"
  }
}
