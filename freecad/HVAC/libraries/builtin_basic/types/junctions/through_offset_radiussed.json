{
  "id": "through_offset_radiussed",
  "label": "Offset - Radiussed",
  "category": "junction",
  "topology": "through",
  "family": [
    "through.offset"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 40
  },
  "constraints": {
    "degree": 2
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "OffsetLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Length of the offset along the duct axis. 0 uses the duct size",
      "default": 300.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "OffsetRadius",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Centreline radius of the two arcs. 0 uses the duct size",
      "default": 50.0,
      "validation": {
        "minimum": 0.0
      }
    }
  ],
  "generator": {
    "module": "shared:offsets",
    "function": "build_offset_radiussed"
  },
  "connection_lengths": {
    "module": "shared:offsets",
    "function": "measure_offset_radiussed"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_offset_generic"
  }
}
