{
  "id": "cross_generic",
  "label": "Cross - Generic",
  "category": "junction",
  "topology": "cross",
  "family": [
    "cross.cross",
    "cross.cross.3d",
    "cross.double_wye",
    "cross.double_wye.3d",
    "cross.generic"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval",
    "Generic"
  ],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "constraints": {
    "degree": 4
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "TrimLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length of each port, measured from the node. 0 uses a size-based default",
      "default": 100.0,
      "per_port": true,
      "validation": {
        "minimum": 0.0
      }
    }
  ],
  "geometry": {
    "backend": "generator",
    "module": "shared:stars",
    "function": "build_cross"
  },
  "connection_lengths": {
    "module": "shared:stars",
    "function": "measure_cross"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_cross_generic"
  }
}
