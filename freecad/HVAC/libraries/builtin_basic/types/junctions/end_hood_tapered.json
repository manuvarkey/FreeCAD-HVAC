{
  "id": "end_hood_tapered",
  "label": "Hood - Tapered Capture",
  "category": "junction",
  "topology": "end",
  "family": [
    "end.terminal.hood"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 35
  },
  "constraints": {
    "degree": 1,
    "flow_class": {
      "enum": [
        "entry",
        "unknown"
      ]
    }
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "TrimNeck",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Length of the straight collar between the fitting and the duct",
      "default": 50.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "HoodAngle",
      "prop_type": "App::PropertyAngle",
      "group": "Dimensions",
      "description": "Included angle between opposite walls of the hood",
      "default": 60.0,
      "validation": {
        "minimum": 0.0,
        "maximum": 180.0
      }
    },
    {
      "name": "HoodLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Length of the hood along the duct. 0 uses half the duct size",
      "default": 300.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "ScreenFreeArea",
      "prop_type": "App::PropertyFloat",
      "group": "Parameters",
      "description": "Open fraction of a screen across the opening, from 0 to 1. 0 means there is no screen",
      "default": 0.0,
      "validation": {
        "minimum": 0.0,
        "maximum": 1.0
      }
    }
  ],
  "generator": {
    "module": "shared:terminals",
    "function": "build_terminal_cone"
  },
  "connection_lengths": {
    "module": "shared:terminals",
    "function": "measure_terminal_cone"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_hood_tapered"
  }
}
