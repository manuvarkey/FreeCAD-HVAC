{
  "id": "through_transition_offset",
  "label": "Transition - Offset",
  "category": "junction",
  "topology": "through",
  "family": [
    "through.transition"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 60
  },
  "constraints": {
    "degree": 2,
    "qualifiers": {
      "alignment": {
        "enum": [
          "offset"
        ]
      }
    }
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "TransitionLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Transition body length",
      "default": 300.0
    },
    {
      "name": "IncludedAngle",
      "prop_type": "App::PropertyAngle",
      "group": "Derived",
      "description": "Included angle the SMACNA transition tables are read at (read-only, set on recompute)",
      "default": 0.0,
      "editor_mode": 1
    },
    {
      "name": "BodyLength",
      "prop_type": "App::PropertyLength",
      "group": "Derived",
      "description": "Axial length the fitting was built with (read-only, set on recompute)",
      "default": 0.0,
      "editor_mode": 1
    }
  ],
  "geometry": {
    "backend": "generator",
    "module": "shared:transitions",
    "function": "build_transition"
  },
  "connection_lengths": {
    "module": "shared:transitions",
    "function": "measure_transition"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_transition_generic",
    "variants": [
      {
        "constraints": {
          "flow_class": {
            "enum": [
              "expansion"
            ]
          }
        },
        "module": "shared:losses",
        "function": "loss_transition_expansion"
      },
      {
        "constraints": {
          "flow_class": {
            "enum": [
              "contraction"
            ]
          }
        },
        "module": "shared:losses",
        "function": "loss_transition_contraction"
      }
    ]
  }
}
