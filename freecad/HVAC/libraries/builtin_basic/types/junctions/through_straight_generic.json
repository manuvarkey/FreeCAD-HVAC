{
  "id": "through_straight_generic",
  "label": "Straight - Generic",
  "category": "junction",
  "topology": "through",
  "family": ["through.straight"],
  "profiles": ["Circular", "Rectangular", "Oval"],
  "selection": {
    "kind": "model",
    "priority": 60
  },
  "constraints": {
    "degree": 2
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {"minimum": 0.0}
    },
    {
      "name": "Length",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Straight coupling length (no special fitting accessory)",
      "default": 5.0
    }
  ],
  "geometry": {
    "backend": "generator",
    "module": "shared:through",
    "function": "build_straight"
  },
  "connection_lengths": {
    "module": "shared:through",
    "function": "measure_straight"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_transition_generic"
  }
}
