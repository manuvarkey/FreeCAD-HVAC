{
  "id": "cross_tee_straight",
  "label": "Cross - Straight",
  "category": "junction",
  "topology": "cross",
  "family": [
    "cross.cross",
    "cross.cross.3d"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 60
  },
  "constraints": {
    "degree": 4
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "TrimRunA",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for run port A, beyond the fitting's own body",
      "default": 100.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "TrimRunB",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for run port B, beyond the fitting's own body",
      "default": 100.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "TrimBranchA",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for branch port A, beyond the fitting's own body",
      "default": 100.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "TrimBranchB",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for branch port B, beyond the fitting's own body",
      "default": 100.0,
      "validation": {
        "minimum": 0.0
      }
    }
  ],
  "geometry": {
    "backend": "generator",
    "module": "shared:crosses",
    "function": "build_cross_tee_straight"
  },
  "connection_lengths": {
    "module": "shared:crosses",
    "function": "measure_cross_tee_straight"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_cross_generic"
  }
}
