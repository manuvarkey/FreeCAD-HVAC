{
  "id": "through_offset_mitered",
  "label": "Offset - Mitered",
  "category": "junction",
  "topology": "through",
  "family": [
    "through.offset"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "constraints": {
    "degree": 2
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "OffsetLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Length of the offset along the duct axis. 0 uses the duct size",
      "default": 300.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "OffsetAngle",
      "prop_type": "App::PropertyAngle",
      "group": "Derived",
      "description": "Deflection of each corner from the duct axis (read-only, set on recompute)",
      "default": 0.0,
      "editor_mode": 1
    },
    {
      "name": "BodyLength",
      "prop_type": "App::PropertyLength",
      "group": "Derived",
      "description": "Axial length the fitting was built with (read-only, set on recompute)",
      "default": 0.0,
      "editor_mode": 1
    }
  ],
  "geometry": {
    "backend": "generator",
    "module": "shared:offsets",
    "function": "build_offset_mitered"
  },
  "connection_lengths": {
    "module": "shared:offsets",
    "function": "measure_offset_mitered"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_offset_generic"
  }
}
