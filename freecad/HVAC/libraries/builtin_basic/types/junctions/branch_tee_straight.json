{
  "id": "branch_tee_straight",
  "label": "Tee - Straight",
  "category": "junction",
  "topology": "branch",
  "family": ["branch.tee", "branch.tee.3d"],
  "profiles": ["Circular", "Rectangular", "Oval"],
  "selection": {
    "kind": "model",
    "priority": 40
  },
  "constraints": {
    "degree": 3
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {"minimum": 0.0}
    },
    {
      "name": "TrimRunA",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for run port A",
      "default": 100.0
    },
    {
      "name": "TrimRunB",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for run port B",
      "default": 100.0
    },
    {
      "name": "TrimBranch",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for the branch port",
      "default": 100.0
    }
  ],
  "generator": {
    "module": "shared:tees",
    "function": "build_tee_straight"
  },
  "connection_lengths": {
    "module": "shared:tees",
    "function": "measure_tee_straight"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_tee_generic"
  }
}
