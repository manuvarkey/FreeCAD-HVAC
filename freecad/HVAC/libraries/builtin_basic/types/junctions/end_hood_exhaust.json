{
  "id": "end_hood_exhaust",
  "label": "Hood - Exhaust",
  "category": "junction",
  "topology": "end",
  "family": [
    "end.terminal.hood"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 72
  },
  "constraints": {
    "degree": 1,
    "flow_class": {
      "enum": [
        "exit",
        "unknown"
      ]
    }
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "TrimNeck",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Length of the straight collar between the fitting and the duct. 0 uses a quarter of the duct size",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "HoodAngle",
      "prop_type": "App::PropertyAngle",
      "group": "Parameters",
      "description": "Slope of the hood plate. The loss is tabulated for 0 and 15 degrees",
      "default": 0.0,
      "validation": {
        "minimum": 0.0,
        "maximum": 15.0
      }
    },
    {
      "name": "HoodHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Clear distance from the duct end to the hood plate",
      "default": 150.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "ScreenFreeArea",
      "prop_type": "App::PropertyFloat",
      "group": "Parameters",
      "description": "Open fraction of a screen across the opening, from 0 to 1. 0 means there is no screen",
      "default": 0.0,
      "validation": {
        "minimum": 0.0,
        "maximum": 1.0
      }
    }
  ],
  "generator": {
    "module": "shared:terminals",
    "function": "build_terminal_hood"
  },
  "connection_lengths": {
    "module": "shared:terminals",
    "function": "measure_terminal_hood"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_hood_exhaust"
  }
}
