{
  "id": "through_transition_eccentric",
  "label": "Transition - Eccentric",
  "category": "junction",
  "topology": "through",
  "family": [
    "through.transition"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 61
  },
  "constraints": {
    "degree": 2,
    "qualifiers": {
      "alignment": {
        "enum": [
          "eccentric",
          "double_eccentric"
        ]
      }
    }
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "TransitionLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Transition body length",
      "default": 300.0
    }
  ],
  "generator": {
    "module": "shared:transitions",
    "function": "build_transition"
  },
  "connection_lengths": {
    "module": "shared:transitions",
    "function": "measure_transition"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_transition_generic",
    "variants": [
      {
        "constraints": {
          "flow_class": {
            "enum": [
              "expansion"
            ]
          }
        },
        "module": "shared:losses",
        "function": "loss_transition_expansion"
      },
      {
        "constraints": {
          "flow_class": {
            "enum": [
              "contraction"
            ]
          }
        },
        "module": "shared:losses",
        "function": "loss_transition_contraction"
      }
    ]
  }
}
