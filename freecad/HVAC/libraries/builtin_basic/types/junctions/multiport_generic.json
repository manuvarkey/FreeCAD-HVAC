{
  "id": "multiport_generic",
  "label": "Multiport - Generic",
  "category": "junction",
  "topology": "multiport",
  "family": ["multiport.multiport", "multiport.multiport.3d"],
  "profiles": ["Circular", "Rectangular", "Oval", "Generic"],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "constraints": {
    "degree_min": 5
  },
  "properties": [
    {
      "name": "TrimLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for ports",
      "default": 100.0
    }
  ],
  "generator": {
    "module": "shared:stars",
    "function": "build_manifold"
  },
  "connection_lengths": {
    "module": "shared:stars",
    "function": "measure_manifold"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_multiport_generic"
  }
}
