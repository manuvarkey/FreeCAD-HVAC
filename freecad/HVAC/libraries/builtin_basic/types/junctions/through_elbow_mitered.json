{
  "id": "through_elbow_mitered",
  "label": "Elbow - Mitered",
  "category": "junction",
  "topology": "through",
  "family": [
    "through.bend",
    "through.bend.3d",
    "through.bend_90",
    "through.bend_90.3d"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "constraints": {
    "degree": 2
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "CenterlineRadius",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Radius of the smooth bend the mitre cuts approximate",
      "default": 300.0
    },
    {
      "name": "NumberOfCuts",
      "prop_type": "App::PropertyInteger",
      "group": "Dimensions",
      "description": "Number of mitre cuts (1 = a single two-piece joint)",
      "default": 1,
      "validation": {"minimum": 1}
    }
  ],
  "geometry": {
    "backend": "generator",
    "module": "shared:elbows",
    "function": "build_elbow_mitered"
  },
  "connection_lengths": {
    "module": "shared:elbows",
    "function": "measure_elbow_mitered"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_elbow_mitered"
  }
}
