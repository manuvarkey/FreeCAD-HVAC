{
  "id": "through_obstruction_generic",
  "label": "Obstruction - Round bar",
  "category": "junction",
  "topology": "through",
  "family": [
    "through.straight.obstruction"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "inline",
    "priority": 50
  },
  "constraints": {
    "degree": 2
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "BodyLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Length of duct modelled with the obstruction. 0 uses half the duct size",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "ObstructionDiameter",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Diameter of the bar crossing the duct",
      "default": 25.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "OffsetFromCentre",
      "prop_type": "App::PropertyDistance",
      "group": "Dimensions",
      "description": "Distance of the bar from the duct centreline (0 = centred)",
      "default": 0.0
    }
  ],
  "geometry": {
    "backend": "generator",
    "module": "shared:inline",
    "function": "build_obstruction_generic"
  },
  "connection_lengths": {
    "module": "shared:inline",
    "function": "measure_obstruction_generic"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_obstruction"
  }
}
