{
  "id": "branch_tap_straight",
  "label": "Tap - Straight",
  "category": "junction",
  "topology": "branch",
  "family": ["branch.tee"],
  "profiles": ["Circular", "Rectangular", "Oval"],
  "selection": {
    "kind": "model",
    "priority": 25
  },
  "constraints": {
    "degree": 3
  },
  "properties": [
    {
      "name": "TrimRunA",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for run port A",
      "default": 60.0
    },
    {
      "name": "TrimRunB",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for run port B",
      "default": 60.0
    },
    {
      "name": "TrimBranch",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for the tap's own branch duct",
      "default": 80.0
    }
  ],
  "generator": {
    "module": "junctions",
    "function": "build_tap_straight"
  },
  "loss": {
    "module": "junction_losses",
    "function": "loss_tee_generic"
  }
}
