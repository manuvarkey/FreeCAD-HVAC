{
  "id": "through_offset_angled",
  "label": "Offset - Angled",
  "category": "junction",
  "topology": "through",
  "family": ["through.offset"],
  "profiles": ["Circular", "Rectangular", "Oval"],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "constraints": {
    "degree": 2
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Wall thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 1.0,
      "validation": {"minimum": 0.0}
    },
    {
      "name": "TransitionLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Offset body length",
      "default": 300.0
    }
  ],
  "generator": {
    "module": "shared:transitions",
    "function": "build_transition"
  },
  "connection_lengths": {
    "module": "shared:transitions",
    "function": "measure_transition"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_offset_generic"
  }
}
