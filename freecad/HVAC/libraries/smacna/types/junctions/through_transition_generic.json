{
  "id": "through_transition_generic",
  "label": "Transition - Generic",
  "category": "junction",
  "topology": "through",
  "family": [
    "through.transition"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "constraints": {
    "degree": 2
  },
  "properties": [
    {
      "name": "TransitionLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Transition body length",
      "default": 300.0
    },
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness",
      "default": 0.8
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange height",
      "default": 25.0
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange thickness",
      "default": 1.0
    },
    {
      "name": "ShowFlange1",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 1",
      "default": true
    },
    {
      "name": "ShowFlange2",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 2",
      "default": true
    },
    {
      "name": "InsulationThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Insulation thickness wrapped around the outside of the transition; 0 disables insulation",
      "default": 0.0
    },
    {
      "name": "IncludedAngle",
      "prop_type": "App::PropertyAngle",
      "group": "Derived",
      "description": "Included angle the SMACNA transition tables are read at (read-only, set on recompute)",
      "default": 0.0,
      "editor_mode": 1
    },
    {
      "name": "BodyLength",
      "prop_type": "App::PropertyLength",
      "group": "Derived",
      "description": "Axial length the fitting was built with (read-only, set on recompute)",
      "default": 0.0,
      "editor_mode": 1
    }
  ],
  "construction": {
    "layers": [
      {
        "id": "casing",
        "roles": [
          "flow_surface",
          "structural_shell"
        ],
        "default_material_role": "structural_shell",
        "thickness_property": "Thickness"
      },
      {
        "id": "insulation",
        "roles": ["thermal_insulation"],
        "default_material_role": "thermal_insulation",
        "thickness_property": "InsulationThickness"
      }
    ],
    "features": [
      {
        "id": "transverse_flange",
        "role": "transverse_joint",
        "host_layer": "casing",
        "module": "shared:features",
        "generator": "transverse_flange",
        "parameters": [
          "FlangeHeight",
          "FlangeThickness",
          "ShowFlange1",
          "ShowFlange2"
        ]
      }
    ]
  },
  "generator": {
    "module": "shared:transitions",
    "function": "build_transition"
  },
  "connection_lengths": {
    "module": "shared:transitions",
    "function": "measure_transition"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_transition_generic",
    "variants": [
      {
        "constraints": {
          "flow_class": {"enum": ["expansion"]}
        },
        "module": "shared:losses",
        "function": "loss_transition_expansion"
      },
      {
        "constraints": {
          "flow_class": {"enum": ["contraction"]}
        },
        "module": "shared:losses",
        "function": "loss_transition_contraction"
      }
    ]
  }
}
