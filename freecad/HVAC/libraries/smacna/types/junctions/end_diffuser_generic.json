{
  "id": "end_diffuser_generic",
  "label": "Diffuser / Grille / Register - Generic",
  "category": "junction",
  "topology": "end",
  "family": [
    "end.terminal.diffuser",
    "end.terminal.grille",
    "end.terminal.register"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "constraints": {
    "degree": 1
  },
  "properties": [
    {
      "name": "NeckSize",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Diffuser/grille/register neck (collar) diameter",
      "default": 200.0
    },
    {
      "name": "LossCoefficient",
      "prop_type": "App::PropertyFloat",
      "group": "Parameters",
      "description": "Pressure-loss coefficient K, referenced to velocity at the neck",
      "default": 1.0
    }
  ],
  "generator": {
    "module": "shared:terminals",
    "function": "build_terminal_body_generic"
  },
  "connection_lengths": {
    "module": "shared:terminals",
    "function": "measure_terminal_body_generic"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_diffuser_generic"
  }
}
