{
  "id": "branch_tee_generic",
  "label": "Tee - Generic",
  "category": "junction",
  "topology": "branch",
  "family": [
    "branch.tee",
    "branch.lateral_tee",
    "branch.tee.3d",
    "branch.lateral_tee.3d"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "constraints": {
    "degree": 3
  },
  "properties": [
    {
      "name": "RunTrimLengthA",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for the main run ports",
      "default": 100.0
    },
    {
      "name": "RunTrimLengthB",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for the main run ports",
      "default": 100.0
    },
    {
      "name": "BranchTrimLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for the branch port",
      "default": 100.0
    },
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness",
      "default": 0.8
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange height",
      "default": 25.0
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange thickness",
      "default": 1.0
    },
    {
      "name": "ShowFlangeA",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at run port A",
      "default": true
    },
    {
      "name": "ShowFlangeB",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at run port B",
      "default": true
    },
    {
      "name": "ShowFlangeBranch",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at the branch port",
      "default": true
    }
  ],
  "construction": {
    "layers": [
      {
        "id": "casing",
        "roles": [
          "flow_surface",
          "structural_shell"
        ],
        "default_material_role": "structural_shell",
        "thickness_property": "Thickness"
      }
    ]
  },
  "generator": {
    "module": "junctions",
    "function": "build_tee"
  },
  "loss": {
    "module": "junction_losses",
    "function": "loss_tee_generic"
  }
}
