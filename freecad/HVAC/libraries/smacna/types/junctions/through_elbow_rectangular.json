{
  "id": "through_elbow_rectangular",
  "label": "Elbow - Rectangular",
  "category": "junction",
  "topology": "through",
  "family": [
    "through.bend",
    "through.bend.3d",
    "through.bend_90",
    "through.bend_90.3d"
  ],
  "profiles": [
    "Rectangular"
  ],
  "selection": {
    "kind": "model",
    "priority": 100
  },
  "constraints": {
    "degree": 2
  },
  "properties": [
    {
      "name": "CenterlineRadius",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Elbow centerline radius",
      "default": 300.0
    },
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness",
      "default": 0.8
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange height",
      "default": 25.0
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange thickness",
      "default": 1.0
    },
    {
      "name": "ShowFlange1",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 1",
      "default": true
    },
    {
      "name": "ShowFlange2",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 2",
      "default": true
    }
  ],
  "construction": {
    "layers": [
      {
        "id": "casing",
        "roles": [
          "flow_surface",
          "structural_shell"
        ],
        "default_material_role": "structural_shell",
        "thickness_property": "Thickness"
      }
    ]
  },
  "geometry": {
    "backend": "partscript",
    "file": "models/through_elbow_rectangular.py"
  },
  "loss": {
    "module": "junction_losses",
    "function": "loss_elbow_generic"
  }
}
