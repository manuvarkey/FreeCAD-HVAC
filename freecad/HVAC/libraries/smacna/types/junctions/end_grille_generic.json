{
  "id": "end_grille_generic",
  "label": "Grille - Generic",
  "category": "junction",
  "topology": "end",
  "family": [
    "end.terminal.grille"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 86
  },
  "constraints": {
    "degree": 1,
    "qualifiers": {
      "terminal_function": {
        "enum": [
          "Supply",
          "Return",
          "Exhaust"
        ]
      }
    }
  },
  "properties": [
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness. 0 builds the air space as a solid body instead of a hollow shell",
      "default": 0.8,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "InsulationThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Insulation thickness wrapped around the outside of the fitting; 0 disables insulation",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "TrimNeck",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Length of the straight collar between the fitting and the duct. 0 uses a quarter of the duct size",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "FrameWidth",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Width of the frame around the opening. 0 leaves the frame out",
      "default": 25.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "FrameDepth",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Depth of the frame along the duct",
      "default": 20.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "LossMode",
      "prop_type": "App::PropertyEnumeration",
      "group": "Parameters",
      "description": "How the loss is given: a coefficient K, or a fixed pressure drop from the maker's data",
      "default": "Coefficient",
      "validation": {
        "enum": [
          "Coefficient",
          "Fixed pressure drop"
        ]
      }
    },
    {
      "name": "LossCoefficient",
      "prop_type": "App::PropertyFloat",
      "group": "Parameters",
      "description": "Pressure-loss coefficient K, referenced to velocity at the neck",
      "default": 1.5,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "NeckSize",
      "prop_type": "App::PropertyLength",
      "group": "Parameters",
      "description": "Equivalent neck diameter the loss coefficient refers to. Used for the loss only, not for the shape",
      "default": 200.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "PressureDrop",
      "prop_type": "App::PropertyFloat",
      "group": "Parameters",
      "description": "Pressure drop in Pa at the design flow, used when LossMode is Fixed pressure drop",
      "default": 0.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Height of the transverse flange at each duct connection",
      "default": 25.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Thickness of the transverse flange; 0 draws no flanges",
      "default": 1.0,
      "validation": {
        "minimum": 0.0
      }
    },
    {
      "name": "ShowFlange1",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at the duct connection",
      "default": true
    }
  ],
  "construction": {
    "layers": [
      {
        "id": "casing",
        "roles": [
          "flow_surface",
          "structural_shell"
        ],
        "default_material_role": "structural_shell",
        "thickness_property": "Thickness"
      },
      {
        "id": "insulation",
        "roles": [
          "thermal_insulation"
        ],
        "default_material_role": "thermal_insulation",
        "thickness_property": "InsulationThickness"
      }
    ],
    "features": [
      {
        "id": "transverse_flange",
        "role": "transverse_joint",
        "host_layer": "casing",
        "module": "shared:features",
        "generator": "transverse_flange",
        "parameters": [
          "FlangeHeight",
          "FlangeThickness",
          "ShowFlange1"
        ]
      }
    ]
  },
  "geometry": {
    "backend": "generator",
    "module": "shared:terminals",
    "function": "build_terminal_frame"
  },
  "connection_lengths": {
    "module": "shared:terminals",
    "function": "measure_terminal_frame"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_diffuser_generic"
  }
}
