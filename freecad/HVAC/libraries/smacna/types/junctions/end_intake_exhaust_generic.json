{
  "id": "end_intake_exhaust_generic",
  "label": "Intake / Exhaust Louver - Generic",
  "category": "junction",
  "topology": "end",
  "family": [
    "end.terminal.louver",
    "end.terminal.hood"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 75
  },
  "constraints": {
    "degree": 1
  },
  "properties": [
    {
      "name": "NeckSize",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Louver/hood neck (collar) diameter",
      "default": 200.0
    },
    {
      "name": "LossCoefficient",
      "prop_type": "App::PropertyFloat",
      "group": "Parameters",
      "description": "Pressure-loss coefficient K, referenced to velocity at the neck (louvers/hoods are typically more restrictive than diffusers, e.g. bird screens/blades)",
      "default": 2.0
    }
  ],
  "generator": {
    "module": "shared:terminals",
    "function": "build_terminal_body_generic"
  },
  "connection_lengths": {
    "module": "shared:terminals",
    "function": "measure_terminal_body_generic"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_diffuser_generic"
  }
}
