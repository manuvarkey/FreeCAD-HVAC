{
  "id": "cross_generic",
  "label": "Cross - Generic",
  "category": "junction",
  "topology": "cross",
  "family": [
    "cross.cross",
    "cross.cross.3d",
    "cross.double_wye",
    "cross.double_wye.3d",
    "cross.generic"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval",
    "Generic"
  ],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "constraints": {
    "degree": 4
  },
  "properties": [
    {
      "name": "TrimPortA",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for port A",
      "default": 100.0
    },
    {
      "name": "TrimPortB",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for port B",
      "default": 100.0
    },
    {
      "name": "TrimPortC",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for port C",
      "default": 100.0
    },
    {
      "name": "TrimPortD",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for port D",
      "default": 100.0
    },
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness",
      "default": 0.8
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange height",
      "default": 25.0
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange thickness",
      "default": 1.0
    },
    {
      "name": "ShowFlangePortA",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port A",
      "default": true
    },
    {
      "name": "ShowFlangePortB",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port B",
      "default": true
    },
    {
      "name": "ShowFlangePortC",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port C",
      "default": true
    },
    {
      "name": "ShowFlangePortD",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port D",
      "default": true
    },
    {
      "name": "InsulationThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Insulation thickness wrapped around the outside of the fitting; 0 disables insulation",
      "default": 0.0
    }
  ],
  "construction": {
    "layers": [
      {
        "id": "casing",
        "roles": [
          "flow_surface",
          "structural_shell"
        ],
        "default_material_role": "structural_shell",
        "thickness_property": "Thickness"
      },
      {
        "id": "insulation",
        "roles": ["thermal_insulation"],
        "default_material_role": "thermal_insulation",
        "thickness_property": "InsulationThickness"
      }
    ]
  },
  "generator": {
    "module": "shared:stars",
    "function": "build_cross"
  },
  "connection_lengths": {
    "module": "shared:stars",
    "function": "measure_cross"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_cross_generic"
  }
}
