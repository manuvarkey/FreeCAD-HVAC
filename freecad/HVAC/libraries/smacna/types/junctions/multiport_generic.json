{
  "id": "multiport_generic",
  "label": "Multiport - Generic",
  "category": "junction",
  "topology": "multiport",
  "family": ["multiport.multiport", "multiport.multiport.3d"],
  "profiles": ["Circular", "Rectangular", "Oval", "Generic"],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "constraints": {
    "degree_min": 5
  },
  "properties": [
    {
      "name": "TrimLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for ports",
      "default": 100.0
    },
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness",
      "default": 0.8
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange height",
      "default": 25.0
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange thickness",
      "default": 1.0
    },
    {
      "name": "ShowFlange",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at every port",
      "default": true
    }
  ],
  "generator": {
    "module": "junctions",
    "function": "build_manifold"
  },
  "loss": {
    "module": "junction_losses",
    "function": "loss_multiport_generic"
  }
}
