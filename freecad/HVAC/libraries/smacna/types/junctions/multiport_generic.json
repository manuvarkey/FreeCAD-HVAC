{
  "id": "multiport_generic",
  "label": "Multiport - Generic",
  "category": "junction",
  "topology": "multiport",
  "family": [
    "multiport.multiport",
    "multiport.multiport.3d"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval",
    "Generic"
  ],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "constraints": {
    "degree_min": 5
  },
  "properties": [
    {
      "name": "TrimLength",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Trim length for ports",
      "default": 100.0
    },
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness",
      "default": 0.8
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange height",
      "default": 25.0
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange thickness",
      "default": 1.0
    },
    {
      "name": "ShowFlange",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at every port",
      "default": true
    },
    {
      "name": "InsulationThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Insulation thickness wrapped around the outside of the fitting; 0 disables insulation",
      "default": 0.0
    }
  ],
  "construction": {
    "layers": [
      {
        "id": "casing",
        "roles": [
          "flow_surface",
          "structural_shell"
        ],
        "default_material_role": "structural_shell",
        "thickness_property": "Thickness"
      },
      {
        "id": "insulation",
        "roles": ["thermal_insulation"],
        "default_material_role": "thermal_insulation",
        "thickness_property": "InsulationThickness"
      }
    ]
  },
  "generator": {
    "module": "junctions",
    "function": "build_manifold"
  },
  "loss": {
    "module": "junction_losses",
    "function": "loss_multiport_generic"
  }
}
