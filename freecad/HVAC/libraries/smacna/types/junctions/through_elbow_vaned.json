{
  "id": "through_elbow_vaned",
  "label": "Elbow - Mitered with Turning Vanes",
  "category": "junction",
  "topology": "through",
  "family": [
    "through.bend_90",
    "through.bend_90.3d"
  ],
  "profiles": [
    "Rectangular"
  ],
  "selection": {
    "kind": "model",
    "priority": 30
  },
  "constraints": {
    "degree": 2
  },
  "properties": [
    {
      "name": "CenterlineRadius",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sets how far the elbow reaches along each duct; the corner itself is square",
      "default": 300.0
    },
    {
      "name": "VaneDesign",
      "prop_type": "App::PropertyEnumeration",
      "group": "Parameters",
      "description": "Turning vanes fitted in the corner: single or double thickness, vane radius R and spacing S in mm. Used for the loss; the vanes are not drawn",
      "default": "Single R50 S38",
      "validation": {
        "enum": [
          "Single R50 S38",
          "Single R114 S83",
          "Double R50 S38",
          "Double R50 S56",
          "Double R114 S83"
        ]
      }
    },
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness",
      "default": 0.8
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange height",
      "default": 25.0
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange thickness",
      "default": 1.0
    },
    {
      "name": "ShowFlange1",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 1",
      "default": true
    },
    {
      "name": "ShowFlange2",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 2",
      "default": true
    },
    {
      "name": "InsulationThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Insulation thickness wrapped around the outside of the elbow; 0 disables insulation",
      "default": 0.0
    }
  ],
  "construction": {
    "layers": [
      {
        "id": "casing",
        "roles": [
          "flow_surface",
          "structural_shell"
        ],
        "default_material_role": "structural_shell",
        "thickness_property": "Thickness"
      },
      {
        "id": "insulation",
        "roles": [
          "thermal_insulation"
        ],
        "default_material_role": "thermal_insulation",
        "thickness_property": "InsulationThickness"
      }
    ]
  },
  "generator": {
    "module": "shared:elbows",
    "function": "build_elbow_mitered"
  },
  "connection_lengths": {
    "module": "shared:elbows",
    "function": "measure_elbow_mitered"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_elbow_vaned"
  }
}
