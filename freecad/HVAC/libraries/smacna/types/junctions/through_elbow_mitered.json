{
  "id": "through_elbow_mitered",
  "label": "Elbow - Mitered / Gored",
  "category": "junction",
  "topology": "through",
  "family": [
    "through.bend",
    "through.bend.3d",
    "through.bend_90",
    "through.bend_90.3d"
  ],
  "profiles": [
    "Circular",
    "Rectangular",
    "Oval"
  ],
  "selection": {
    "kind": "model",
    "priority": 60
  },
  "constraints": {
    "degree": 2
  },
  "properties": [
    {
      "name": "CenterlineRadius",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Elbow centerline radius",
      "default": 300.0
    },
    {
      "name": "NumberOfCuts",
      "prop_type": "App::PropertyInteger",
      "group": "Dimensions",
      "description": "Number of mitre joints. 1 is a plain mitered elbow; 2 to 4 make a 3 to 5 piece elbow",
      "default": 2,
      "validation": {
        "minimum": 1
      }
    },
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness",
      "default": 0.8
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange height",
      "default": 25.0
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange thickness",
      "default": 1.0
    },
    {
      "name": "ShowFlange1",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 1",
      "default": true
    },
    {
      "name": "ShowFlange2",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 2",
      "default": true
    },
    {
      "name": "InsulationThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Insulation thickness wrapped around the outside of the elbow; 0 disables insulation",
      "default": 0.0
    }
  ],
  "construction": {
    "layers": [
      {
        "id": "casing",
        "roles": [
          "flow_surface",
          "structural_shell"
        ],
        "default_material_role": "structural_shell",
        "thickness_property": "Thickness"
      },
      {
        "id": "insulation",
        "roles": [
          "thermal_insulation"
        ],
        "default_material_role": "thermal_insulation",
        "thickness_property": "InsulationThickness"
      }
    ],
    "features": [
      {
        "id": "transverse_flange",
        "role": "transverse_joint",
        "host_layer": "casing",
        "module": "shared:features",
        "generator": "transverse_flange",
        "parameters": [
          "FlangeHeight",
          "FlangeThickness",
          "ShowFlange1",
          "ShowFlange2"
        ]
      }
    ]
  },
  "geometry": {
    "backend": "generator",
    "module": "shared:elbows",
    "function": "build_elbow_mitered"
  },
  "connection_lengths": {
    "module": "shared:elbows",
    "function": "measure_elbow_mitered"
  },
  "loss": {
    "module": "shared:losses",
    "function": "loss_elbow_mitered"
  }
}
