{
  "id": "circular_straight",
  "label": "Circular Straight",
  "category": "segment",
  "family": [
    "straight_segment"
  ],
  "profiles": [
    "Circular"
  ],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "properties": [
    {
      "name": "Diameter",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Circular duct diameter",
      "default": 100.0,
      "validation": {
        "exclusiveMinimum": 0.0
      }
    },
    {
      "name": "Thickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Sheet metal thickness",
      "default": 0.8
    },
    {
      "name": "FlangeHeight",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange height",
      "default": 25.0
    },
    {
      "name": "FlangeThickness",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
      "description": "Flange thickness",
      "default": 1.0
    },
    {
      "name": "ShowFlange1",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 1 (start)",
      "default": false
    },
    {
      "name": "ShowFlange2",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Include the flange at port 2 (end)",
      "default": false
    },
    {
      "name": "FlangeVisible",
      "prop_type": "App::PropertyBool",
      "group": "Options",
      "description": "Show the transverse flange feature in the 3D view; the flange is still generated and part of the object's own geometry either way, only its rendered visibility is affected",
      "default": true
    },
    {
      "name": "InsulationThickness",
      "prop_type": "App::PropertyLength",
      "group": "Parameters",
      "description": "Insulation thickness wrapped around the outside of the duct wall; 0 disables insulation",
      "default": 0.0
    }
  ],
  "construction": {
    "layers": [
      {
        "id": "casing",
        "roles": [
          "flow_surface",
          "structural_shell"
        ],
        "default_material_role": "structural_shell",
        "thickness_property": "Thickness"
      },
      {
        "id": "insulation",
        "roles": [
          "thermal_insulation"
        ],
        "default_material_role": "thermal_insulation",
        "thickness_property": "InsulationThickness"
      }
    ],
    "features": [
      {
        "id": "transverse_flange",
        "role": "transverse_joint",
        "host_layer": "casing",
        "generator": "generate_transverse_flange",
        "visible_parameter": "FlangeVisible",
        "parameters": [
          "Diameter",
          "FlangeHeight",
          "FlangeThickness",
          "ShowFlange1",
          "ShowFlange2"
        ]
      }
    ]
  },
  "geometry": {
    "backend": "partscript",
    "file": "models/circular_straight.py"
  }
}
