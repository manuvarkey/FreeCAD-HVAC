{
  "id": "rectangular_straight",
  "label": "Rectangular Straight",
  "category": "segment",
  "family": [
    "straight_segment"
  ],
  "profiles": [
    "Rectangular"
  ],
  "selection": {
    "kind": "model",
    "priority": 50
  },
  "properties": [
    {
      "name": "Width",
      "prop_type": "App::PropertyLength",
      "group": "Dimensions",
